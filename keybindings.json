[
    // ----------------------------------------------------------------------------------------------------
    // Workbench
    // ----------------------------------------------------------------------------------------------------
    {
        "key": "ctrl+r",
        "command": "workbench.action.openRecent"
    },

    // ----------------------------------------------------------------------------------------------------
    // GitHub Copilot
    // ----------------------------------------------------------------------------------------------------
    {
        "key": "ctrl+8",
        "command": "github.copilot.generate",
        "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused"
    },
    {
        "key": "ctrl+enter",
        "command": "-github.copilot.generate",
        "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused"
    },

    // ----------------------------------------------------------------------------------------------------
    // Antigravity
    // ----------------------------------------------------------------------------------------------------
    {
        "key": "ctrl+shift+8",
        "command": "antigravity.startNewConversation"
    },
    {
        "key": "ctrl+shift+l",
        "command": "-antigravity.startNewConversation"
    }
]
